# Copy this file to frontend/.env (not committed) and adjust if needed.
# Base URL of the Spring Boot API, including the /api/v1 prefix.
VITE_API_BASE_URL=http://localhost:8080/api/v1

# Non-payable QR interface demo only. Normal production builds keep it disabled.
# Opt in locally or build explicitly with --mode qr-demo.
VITE_QR_PAYMENT_DEMO=false

# Synthetic FE-06 fixtures. Development only; npm run dev:preview enables this automatically.
VITE_MANAGER_PREVIEW=false

# Member AI assistant entry points (NX-31). Off by default; true shows the opt-in cards and enables /member/assistant.
VITE_ASSISTANT_ENABLED=false

# Sample account box on the Log in screen (Figma F1-05). Development server only (npm run dev):
# a production build (npm run build) never shows it and never contains these values. Off unless
# VITE_SHOW_SAMPLE_ACCOUNT=true and both values below are set. Use a throwaway demo member account, never staff credentials,
# and keep the real values only in frontend/.env (git-ignored).
VITE_SHOW_SAMPLE_ACCOUNT=false
VITE_SAMPLE_ACCOUNT_EMAIL=
VITE_SAMPLE_ACCOUNT_PASSWORD=
