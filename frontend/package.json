{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "vietqr:tunnel": "powershell -NoProfile -ExecutionPolicy Bypass -File ../scripts/payment/Start-VietQrTunnel.ps1",
    "payos:tunnel": "powershell -NoProfile -ExecutionPolicy Bypass -File ../scripts/payment/Start-PayOsTunnel.ps1",
    "payos:tunnel:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File ../scripts/payment/Stop-PayOsTunnel.ps1",
    "dev:preview": "vite --mode manager-preview",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fontsource/be-vietnam-pro": "^5.3.0",
    "@zxing/browser": "0.2.1",
    "@zxing/library": "0.23.0",
    "qrcode": "1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/node": "^24.13.3",
    "@types/qrcode": "1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
