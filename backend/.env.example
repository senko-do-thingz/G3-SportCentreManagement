# ==============================================================================
# Sportify Backend Environment Configuration Example
# ==============================================================================

# CORS allowed origins (comma-separated URLs)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ==============================================================================
# Note: The following variables configure bank transfer payment instructions.
# They are required for any runtime profile other than "dev".
# In "dev", default fallbacks are loaded from application-dev.yml.
# ==============================================================================

# Bank transfer account holder name
SPORTIFY_PAYMENT_ACCOUNT_NAME="Sportify Sports Center"

# Bank transfer account number
SPORTIFY_PAYMENT_ACCOUNT_NUMBER="0000 1041 2460"

# Bank name / financial institution
SPORTIFY_PAYMENT_BANK="Vietcombank"
