DB_URL=jdbc:sqlserver://localhost:1433;databaseName=sportify;encrypt=true;trustServerCertificate=true
DB_USERNAME=sa
DB_PASSWORD=ChangeMe@12345
JWT_SECRET=ChangeMe_GenerateWith_openssl_rand_base64_32

# CORS: comma separated origins allowed to call the API from a browser (the React app).
# dev falls back to http://localhost:5173,http://localhost:3000 when this is not set.
# prod has no default, so set it to the real frontend origin, for example https://app.example.com
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
SERVER_ADDRESS=127.0.0.1

# The dev values below are placeholders and never produce a payable QR by themselves.
# Local VietQR transfer codes are generated from the NAPAS/VietQR payload format and need no Paygate account.
# Set these only for a bank account the project is allowed to receive funds into. Scanning its QR can transfer money.
SPORTIFY_PAYMENT_LIVE_INSTRUCTIONS_ENABLED=false
SPORTIFY_PAYMENT_BANK_BIN=
SPORTIFY_PAYMENT_ACCOUNT_NAME=Sportify Sports Center
SPORTIFY_PAYMENT_ACCOUNT_NUMBER=0000 1041 2460
SPORTIFY_PAYMENT_BANK=Demo Bank

# Explicit localhost payment completion button for demos only. Dev mode restricts it to loopback server/database.
PAYMENT_LOCAL_DEMO_ENABLED=false

# Flow 5 AI drill drafts for Coaches. CODEOWNER-approved provider: Google Gemini (the only supported provider).
# OFF by default and in CI. For the approved local synthetic-data demo only: AI_DRILLS_ENABLED=true and
# AI_DRILLS_PROVIDER=gemini, with GEMINI_API_KEY set privately here (never commit it). A present key alone never
# turns AI on. Any other provider value, a missing key, timeout, refusal or invalid reply uses the rule catalog;
# there is no fallback to another AI provider. Only AiDrillPolicy.safeContext (sport/level/goal codes, counts,
# scores, focus tags) is sent. Unpaid Gemini tier: Google may use content to improve products and humans may
# review it, so send synthetic fixture data only until a paid tier and data-sharing terms are approved.
AI_DRILLS_ENABLED=false
AI_DRILLS_PROVIDER=gemini
GEMINI_API_KEY=
# AI_DRILLS_GEMINI_MODEL=gemini-3.5-flash-lite  (pinned; live-verified 2026-11-07 with synthetic data)
# AI_DRILLS_TIMEOUT_SECONDS=30

# Flow 6 Member assistant AI (Spori chat). With AI on and provider gemini, Gemini understands the question and writes
# the chat reply from the center data the rules looked up. It needs GEMINI_API_KEY above, set privately (never commit
# it). The question text (e-mail addresses and phone numbers removed) and the open chat history are sent to Gemini;
# private and health questions are answered locally and never sent. Without a key, or when a call fails, Spori uses
# the fixed rule answers. Provider and model need CODEOWNER approval.
AI_ASSISTANT_ENABLED=true
# gemini (GEMINI_API_KEY) or claude (ANTHROPIC_API_KEY; classification only, replies stay rule-based).
AI_ASSISTANT_PROVIDER=gemini
ANTHROPIC_API_KEY=
# AI_ASSISTANT_REPLY_ENABLED=true   set false to keep only AI classification with fixed rule answers
# AI_ASSISTANT_MODEL=claude-opus-5-5
# AI_ASSISTANT_GEMINI_MODEL=gemini-flash-lite-latest
# AI_ASSISTANT_TIMEOUT_SECONDS=15

# PROPOSED local canonical demo only; CODEOWNER operational approval required.
# Profiles dev,unified-demo; SERVER_ADDRESS=127.0.0.1; exact numeric loopback DB_URL.
# IDs must be dedicated synthetic Members with emails ending @unified-demo.invalid.
PAYMENT_UNIFIED_DEMO_ENABLED=false
PAYMENT_UNIFIED_DEMO_TEST_ENABLED=false
PAYMENT_UNIFIED_DEMO_MEMBER_IDS=
