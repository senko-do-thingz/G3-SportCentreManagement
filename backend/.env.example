DB_URL=jdbc:sqlserver://localhost:1433;databaseName=sportify;encrypt=true;trustServerCertificate=true
DB_USERNAME=sa
DB_PASSWORD=ChangeMe@12345
JWT_SECRET=ChangeMe_GenerateWith_openssl_rand_base64_32

# CORS: comma separated origins allowed to call the API from a browser (the React app).
# dev falls back to http://localhost:5173,http://localhost:3000 when this is not set.
# prod has no default, so set it to the real frontend origin, for example https://app.example.com
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Bank transfer payment instructions. Required for any profile other than dev.
# In dev, default fallbacks are loaded from application-dev.yml.
SPORTIFY_PAYMENT_ACCOUNT_NAME=Sportify Sports Center
SPORTIFY_PAYMENT_ACCOUNT_NUMBER=0000 1041 2460
SPORTIFY_PAYMENT_BANK=Demo Bank

# Flow 5 AI drill drafts for Coaches (optional, off by default). Needs the API key of the selected provider.
# Only de-identified training data (sport, levels, goal, scores, coach feedback) is sent. Any failure uses the rule catalog.
AI_DRILLS_ENABLED=false
# claude (paid, ANTHROPIC_API_KEY) or gemini (free tier available, GEMINI_API_KEY from aistudio.google.com).
AI_DRILLS_PROVIDER=claude
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# AI_DRILLS_GEMINI_MODEL=gemini-flash-lite-latest  (fast; gemini-flash-latest is often overloaded on the free tier)
# AI_DRILLS_MODEL=claude-opus-5-5
# AI_DRILLS_TIMEOUT_SECONDS=30

# Flow 6 Member assistant AI (optional, off by default). The AI only classifies the question (English or Vietnamese);
# answers always come from center data. Uses the same provider and key as Flow 5 unless overridden.
# Only the question text is sent, with e-mail addresses and phone numbers removed; private and health questions are never sent.
AI_ASSISTANT_ENABLED=false
# AI_ASSISTANT_PROVIDER=gemini
# AI_ASSISTANT_TIMEOUT_SECONDS=15

# PROPOSED local canonical demo only; CODEOWNER operational approval required.
# Profiles dev,unified-demo; SERVER_ADDRESS=127.0.0.1; exact numeric loopback DB_URL.
# IDs must be dedicated synthetic Members with emails ending @unified-demo.invalid.
PAYMENT_UNIFIED_DEMO_ENABLED=false
PAYMENT_UNIFIED_DEMO_TEST_ENABLED=false
PAYMENT_UNIFIED_DEMO_MEMBER_IDS=
