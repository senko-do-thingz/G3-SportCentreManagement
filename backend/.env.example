DB_URL=jdbc:sqlserver://localhost:1433;databaseName=sportify;encrypt=true;trustServerCertificate=true
DB_USERNAME=sa
DB_PASSWORD=ChangeMe@12345
JWT_SECRET=ChangeMe_GenerateWith_openssl_rand_base64_32

# CORS: comma separated origins allowed to call the API from a browser (the React app).
# dev falls back to http://localhost:5173,http://localhost:3000 when this is not set.
# prod has no default, so set it to the real frontend origin, for example https://app.example.com
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Bank transfer payment instructions. Required for any profile other than dev.
# In dev, default fallbacks are loaded from application-dev.yml.
SPORTIFY_PAYMENT_ACCOUNT_NAME=Sportify Sports Center
SPORTIFY_PAYMENT_ACCOUNT_NUMBER=0000 1041 2460
SPORTIFY_PAYMENT_BANK=Demo Bank
