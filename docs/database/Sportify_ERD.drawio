      <mxCell id="p0c81" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=ERmandOne;startArrow=ERmany;endFill=0;startFill=0;strokeColor=#000000;strokeWidth=1.5;exitX=0;exitY=0.5988;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1;entryY=0.5357;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="p0c42" target="p0c39"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="926" y="867" /><mxPoint x="926" y="815" /></Array></mxGeometry></mxCell>
      <mxCell id="p0c82" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=ERmandOne;startArrow=ERmany;endFill=0;startFill=0;strokeColor=#000000;strokeWidth=1.5;exitX=0;exitY=0.5221;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1;entryY=0.5357;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="p0c5" target="p0c2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="571" y="311" /><mxPoint x="571" y="285" /></Array></mxGeometry></mxCell>
      <mxCell id="p0c83" value="&lt;b&gt;Business rules shown by this diagram&lt;/b&gt;&lt;br&gt;&lt;br&gt;1. Booking, check-in and attendance are separate records.&lt;br&gt;check_in is a front-desk arrival; attendance_record is&lt;br&gt;marked by a Coach or Receptionist and has no FK to&lt;br&gt;check_in, so arrival is not a precondition.&lt;br&gt;&lt;br&gt;2. class_session.id is the stable internal key.&lt;br&gt;session_code is the public Session ID; it can change when&lt;br&gt;a Manager reschedules, and old codes are kept in&lt;br&gt;session_code_history.&lt;br&gt;&lt;br&gt;5. sport_package_registration.status: PENDING_PAYMENT,&lt;br&gt;ACTIVE, EXPIRED, CANCELLED, REFUNDED.&lt;br&gt;&lt;br&gt;6. booking.package_registration_id is nullable;&lt;br&gt;booking.status is CONFIRMED or CANCELLED.&lt;br&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=14;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="2880" y="160" width="520" height="426" as="geometry" /></mxCell>
      <mxCell id="p0c84" value="Notation: PK primary key, FK foreign key, NULL nullable column.&lt;br&gt;Lines: many side at the FK table, one side at the referenced table;&lt;br&gt;a circle on the one side means the FK is nullable (zero or one).&lt;br&gt;FKs to tables not on the page are listed as text in the column row.&lt;br&gt;Overview pages: member_id FKs to member_profile are listed as text, not drawn.&lt;br&gt;(legacy) deprecated but present; (schema only) table exists, no current code uses it." style="text;html=1;align=left;verticalAlign=top;fontSize=13;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1730" y="62" width="1690" height="70" as="geometry" /></mxCell>
    </root></mxGraphModel>
  </diagram>
