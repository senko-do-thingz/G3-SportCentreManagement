      <mxCell id="p1c84" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=ERmandOne;startArrow=ERmany;endFill=0;startFill=0;strokeColor=#000000;strokeWidth=1.5;exitX=0;exitY=0.5221;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1;entryY=0.3309;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="p1c37" target="p1c22"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1537" y="789" /><mxPoint x="1537" y="537" /></Array></mxGeometry></mxCell>
      <mxCell id="p1c85" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=ERzeroToOne;startArrow=ERmany;endFill=0;startFill=0;strokeColor=#000000;strokeWidth=1.5;exitX=1;exitY=0.7593;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1;entryY=0.3309;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="p1c6" target="p1c22"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1551" y="363" /><mxPoint x="1551" y="537" /></Array></mxGeometry></mxCell>
      <mxCell id="p1c86" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=ERzeroToOne;startArrow=ERmany;endFill=0;startFill=0;strokeColor=#000000;strokeWidth=1.5;exitX=0;exitY=0.7132;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1;entryY=0.2778;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="p1c56" target="p1c50"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1565" y="1041" /><mxPoint x="1565" y="989" /></Array></mxGeometry></mxCell>
      <mxCell id="p1c87" value="&lt;b&gt;Business rules shown by this diagram&lt;/b&gt;&lt;br&gt;&lt;br&gt;1. Booking, check-in and attendance are separate records.&lt;br&gt;check_in is a front-desk arrival; attendance_record is&lt;br&gt;marked by a Coach or Receptionist and has no FK to&lt;br&gt;check_in, so arrival is not a precondition.&lt;br&gt;&lt;br&gt;3. VietQR bank transfer uses the normal payment row. QR&lt;br&gt;Payment Simulation uses simulated_qr_session and&lt;br&gt;simulated_payment_transaction; simulations never count as&lt;br&gt;real revenue, cash events or refunds.&lt;br&gt;&lt;br&gt;4. simulated_qr_session.state: PENDING -&amp;gt;&lt;br&gt;AUTHORIZED_PENDING_SETTLEMENT -&amp;gt; SETTLED, PENDING -&amp;gt;&lt;br&gt;SETTLED, or PENDING / AUTHORIZED_PENDING_SETTLEMENT -&amp;gt;&lt;br&gt;CANCELED or EXPIRED.&lt;br&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=14;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="2111" y="160" width="520" height="404" as="geometry" /></mxCell>
      <mxCell id="p1c88" value="Notation: PK primary key, FK foreign key, NULL nullable column.&lt;br&gt;Lines: many side at the FK table, one side at the referenced table;&lt;br&gt;a circle on the one side means the FK is nullable (zero or one).&lt;br&gt;FKs to tables not on the page are listed as text in the column row.&lt;br&gt;Overview pages: member_id FKs to member_profile are listed as text, not drawn.&lt;br&gt;(legacy) deprecated but present; (schema only) table exists, no current code uses it." style="text;html=1;align=left;verticalAlign=top;fontSize=13;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1345" y="62" width="1305" height="70" as="geometry" /></mxCell>
    </root></mxGraphModel>
  </diagram>
