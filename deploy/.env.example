# ==============================================================================
# Sportify Backend Server Deployment Environment Variables
# Copy this template to DEPLOY_DIR/.env on the target server.
#
# NOTE: Do NOT define IMAGE_TAG in this file. The GitHub Actions deployment
# workflow automatically injects IMAGE_TAG at runtime for docker compose pull/up.
# ==============================================================================

# ==============================================================================
# Option 1: Database Settings for Compose Profile 'with-db' (Single-Host Containerized DB)
# When COMPOSE_PROFILES=with-db is active, SQL Server runs in Docker on the same host.
# In this profile, the backend connects as the superuser 'sa'.
# DB_PASSWORD is passed directly to MSSQL_SA_PASSWORD.
# ==============================================================================
DB_URL=jdbc:sqlserver://sqlserver:1433;databaseName=sportify;encrypt=true;trustServerCertificate=true
DB_USERNAME=sa
DB_PASSWORD=ChangeMe_StrongDbPassword_12345
COMPOSE_PROFILES=with-db

# ==============================================================================
# Option 2: Database Settings for External SQL Server (Dedicated Production DB)
# When using an external SQL Server, disable with-db by commenting COMPOSE_PROFILES above.
# Use a dedicated least-privilege application user (e.g., sportify_user), NOT sa.
# ==============================================================================
# DB_URL=jdbc:sqlserver://db-host.example.com:1433;databaseName=sportify;encrypt=true;trustServerCertificate=false
# DB_USERNAME=sportify_user
# DB_PASSWORD=ChangeMe_StrongDbPassword_12345

# JWT Secret: HMAC-SHA key for signing authentication tokens (minimum 256 bits / 32 bytes)
# Generate with: openssl rand -base64 32
JWT_SECRET=ChangeMe_GenerateWith_openssl_rand_base64_32

# CORS: Comma-separated list of allowed frontend origins (e.g. https://sportify.example.com)
# When empty, cross-origin browser requests are rejected.
CORS_ALLOWED_ORIGINS=https://sportify.example.com

# Payment configuration (Bank transfer instructions displayed to users)
# Required for staging and production profiles (no default in base application.yml).
SPORTIFY_PAYMENT_ACCOUNT_NAME=Sportify Sports Center
SPORTIFY_PAYMENT_ACCOUNT_NUMBER=0000 1041 2460
SPORTIFY_PAYMENT_BANK=Demo Bank
